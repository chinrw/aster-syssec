{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asterinas.dev/syssec/run-manifest.schema.json",
  "title": "aster-syssec run manifest",
  "type": "object",
  "required": [
    "schema_version", "run_id", "command", "started_at", "status", "source",
    "configuration_hash", "tool_versions", "parameters", "outputs"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string" },
    "command": { "type": "string" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": ["string", "null"], "format": "date-time" },
    "status": { "enum": ["running", "completed", "failed"] },
    "source": { "type": "object" },
    "configuration_hash": { "type": "string" },
    "tool_versions": { "type": "object" },
    "parameters": { "type": "object" },
    "outputs": { "type": "array", "items": { "type": "string" } }
  }
}
