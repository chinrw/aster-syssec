{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asterinas.dev/syssec/loom-result.schema.json",
  "title": "aster-syssec Loom model result",
  "allOf": [
    { "$ref": "https://asterinas.dev/syssec/engine-result.schema.json" },
    {
      "properties": {
        "engine": { "const": "loom" },
        "engine_details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "test",
            "target_triple",
            "max_branches",
            "max_preemptions",
            "max_permutations",
            "tests"
          ],
          "properties": {
            "test": { "type": "string", "minLength": 1 },
            "target_triple": { "type": "string", "minLength": 1 },
            "max_branches": { "type": "integer", "minimum": 1 },
            "max_preemptions": { "type": "integer", "minimum": 0 },
            "max_permutations": { "type": ["integer", "null"], "minimum": 1 },
            "tests": {
              "type": "object",
              "additionalProperties": false,
              "required": ["passed", "failed", "filtered_out"],
              "properties": {
                "passed": { "type": ["integer", "null"], "minimum": 0 },
                "failed": { "type": ["integer", "null"], "minimum": 0 },
                "filtered_out": { "type": ["integer", "null"], "minimum": 0 }
              }
            }
          }
        }
      }
    }
  ]
}
