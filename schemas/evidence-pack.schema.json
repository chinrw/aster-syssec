{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asterinas.dev/syssec/evidence-pack.schema.json",
  "title": "aster-syssec verified evidence pack index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at",
    "content_sha256",
    "manifests",
    "files",
    "limits"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "content_sha256": { "$ref": "#/$defs/sha256" },
    "manifests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "run_id", "status", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/relative_path" },
          "run_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["completed", "failed"] },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size", "kind", "run_id"],
        "properties": {
          "path": { "$ref": "#/$defs/relative_path" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "size": { "type": "integer", "minimum": 0 },
          "kind": { "enum": ["manifest", "artifact"] },
          "run_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_bytes", "max_files"],
      "properties": {
        "max_bytes": { "type": "integer", "minimum": 1 },
        "max_files": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
