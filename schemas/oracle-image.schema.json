{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asterinas.dev/syssec/oracle-image.schema.json",
  "title": "aster-syssec pinned Linux oracle image",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "target_arch",
    "linux_revision",
    "kernel_config",
    "kernel_image",
    "rootfs",
    "qemu"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "target_arch": { "type": "string", "minLength": 1 },
    "linux_revision": {
      "type": "string",
      "oneOf": [
        { "pattern": "^[0-9a-f]{40}$" },
        { "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "kernel_config": { "$ref": "#/$defs/artifact" },
    "kernel_image": { "$ref": "#/$defs/artifact" },
    "rootfs": { "$ref": "#/$defs/artifact" },
    "qemu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "version",
        "machine",
        "cpu",
        "acceleration",
        "memory_bytes",
        "smp"
      ],
      "properties": {
        "executable": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "machine": { "type": "string", "minLength": 1 },
        "cpu": { "type": "string", "minLength": 1 },
        "acceleration": { "enum": ["tcg", "kvm"] },
        "memory_bytes": { "type": "integer", "minimum": 134217728 },
        "smp": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
