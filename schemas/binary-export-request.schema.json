{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asterinas.dev/syssec/binary-export-request.schema.json",
  "title": "aster-syssec static binary export request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "created_at",
    "target",
    "target_config_sha256",
    "guest_case",
    "target_arch",
    "source",
    "evidence_root",
    "limits"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": {
      "type": "string",
      "pattern": "^BINARY-EXPORT-REQUEST-[0-9A-F]{16}$"
    },
    "created_at": { "type": "string", "format": "date-time" },
    "target": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "target_config_sha256": { "$ref": "#/$defs/sha256" },
    "guest_case": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "target_arch": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "revision", "dirty_hash"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "dirty_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidence_root": { "type": "string", "minLength": 1 },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build_timeout_seconds", "output_bytes"],
      "properties": {
        "build_timeout_seconds": { "type": "integer", "minimum": 1 },
        "output_bytes": { "type": "integer", "minimum": 1024 }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
