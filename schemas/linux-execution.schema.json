{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asterinas.dev/syssec/linux-execution.schema.json",
  "title": "aster-syssec Linux oracle execution provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "request_sha256",
    "oracle",
    "binary",
    "derived_initramfs",
    "packer",
    "qemu"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": {
      "type": "string",
      "pattern": "^RUNTIME-REQUEST-[0-9A-F]{16}$"
    },
    "request_sha256": { "$ref": "#/$defs/sha256" },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "metadata_sha256",
        "linux_revision",
        "kernel_config",
        "kernel_image",
        "base_rootfs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "metadata_sha256": { "$ref": "#/$defs/sha256" },
        "linux_revision": {
          "type": "string",
          "oneOf": [
            { "pattern": "^[0-9a-f]{40}$" },
            { "pattern": "^[0-9a-f]{64}$" }
          ]
        },
        "kernel_config": { "$ref": "#/$defs/artifact" },
        "kernel_image": { "$ref": "#/$defs/artifact" },
        "base_rootfs": { "$ref": "#/$defs/artifact" }
      }
    },
    "binary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "source_sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "source_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "derived_initramfs": { "$ref": "#/$defs/artifact" },
    "packer": { "$ref": "#/$defs/command" },
    "qemu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "version",
        "sha256",
        "argv",
        "cwd",
        "environment",
        "machine",
        "cpu",
        "acceleration",
        "memory_bytes",
        "smp"
      ],
      "properties": {
        "executable": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "cwd": { "type": "string", "minLength": 1 },
        "environment": { "$ref": "#/$defs/environment" },
        "machine": { "type": "string", "minLength": 1 },
        "cpu": { "type": "string", "minLength": 1 },
        "acceleration": { "enum": ["tcg", "kvm"] },
        "memory_bytes": { "type": "integer", "minimum": 134217728 },
        "smp": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "version",
        "sha256",
        "argv",
        "cwd",
        "environment"
      ],
      "properties": {
        "executable": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "cwd": { "type": "string", "minLength": 1 },
        "environment": { "$ref": "#/$defs/environment" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "TMPDIR",
        "HOME",
        "XDG_CACHE_HOME",
        "XDG_CONFIG_HOME",
        "XDG_STATE_HOME"
      ],
      "properties": {
        "TMPDIR": { "type": "string", "minLength": 1 },
        "HOME": { "type": "string", "minLength": 1 },
        "XDG_CACHE_HOME": { "type": "string", "minLength": 1 },
        "XDG_CONFIG_HOME": { "type": "string", "minLength": 1 },
        "XDG_STATE_HOME": { "type": "string", "minLength": 1 }
      }
    }
  }
}
