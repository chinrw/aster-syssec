{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asterinas.dev/syssec/engine-command.schema.json",
  "title": "aster-syssec engine command",
  "type": "object",
  "additionalProperties": false,
  "required": ["argv", "cwd"],
  "properties": {
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "cwd": { "type": "string", "minLength": 1 }
  }
}
