{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asterinas.dev/syssec/specula-result.schema.json",
  "title": "Candidate-only normalized Specula result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "engine",
    "status",
    "safety_class",
    "track",
    "source",
    "specula_run_id",
    "gate",
    "model_bounds",
    "tlc_result",
    "counterexample_states",
    "source_anchors",
    "trace_mapping",
    "diagnostics"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "result_id": { "type": "string", "pattern": "^SPECULA-RESULT-[0-9A-F]{16}$" },
    "engine": { "const": "specula" },
    "status": { "const": "candidate" },
    "safety_class": { "const": "model" },
    "track": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "dirty_hash"],
      "properties": {
        "revision": { "type": ["string", "null"] },
        "dirty_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "specula_run_id": { "type": "string", "minLength": 1 },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "request_sha256", "approval_sha256"],
      "properties": {
        "gate_id": { "type": "string", "pattern": "^SPECULA-GATE-[0-9A-F]{16}$" },
        "request_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "approval_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "model_bounds": { "type": "object" },
    "tlc_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "invariant"],
      "properties": {
        "outcome": { "const": "counterexample" },
        "invariant": { "type": "string", "minLength": 1 }
      }
    },
    "counterexample_states": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "source_anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "symbol"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "symbol": { "type": "string", "minLength": 1 }
        }
      }
    },
    "trace_mapping": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "action", "source_anchor"],
        "properties": {
          "state": { "type": "integer", "minimum": 0 },
          "action": { "type": "string", "minLength": 1 },
          "source_anchor": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    "diagnostics": { "type": "array", "items": { "type": "string" } }
  }
}
