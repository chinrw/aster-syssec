{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asterinas.dev/syssec/specula-counterexample-source.schema.json",
  "title": "Restricted Specula counterexample import source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_bounds",
    "tlc_result",
    "counterexample_states",
    "source_anchors",
    "trace_mapping"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "model_bounds": { "type": "object" },
    "tlc_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "invariant"],
      "properties": {
        "outcome": { "const": "counterexample" },
        "invariant": { "type": "string", "minLength": 1 }
      }
    },
    "counterexample_states": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "source_anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "symbol"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "symbol": { "type": "string", "minLength": 1 }
        }
      }
    },
    "trace_mapping": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "action", "source_anchor"],
        "properties": {
          "state": { "type": "integer", "minimum": 0 },
          "action": { "type": "string", "minLength": 1 },
          "source_anchor": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    }
  }
}
