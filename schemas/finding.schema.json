{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asterinas.dev/syssec/finding.schema.json",
  "title": "Asterinas syscall security candidate or finding",
  "type": "object",
  "required": [
    "schema_version", "finding_id", "status", "engine", "track",
    "source_commit", "source_anchor", "violated_property", "evidence",
    "security_impact", "confidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "finding_id": { "type": "string" },
    "status": {
      "enum": [
        "candidate", "refuted", "unsupported-by-scml", "compatibility-only",
        "reproduced", "confirmed-correctness", "confirmed-security", "fixed",
        "regression-promoted"
      ]
    },
    "engine": { "type": "string" },
    "rule_id": { "type": "string" },
    "track": { "type": "string" },
    "source_commit": { "type": ["string", "null"] },
    "source_anchor": {
      "type": "object",
      "required": ["path", "line"],
      "properties": {
        "path": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "symbol": { "type": ["string", "null"] }
      }
    },
    "violated_property": { "type": "string" },
    "evidence": { "type": "string" },
    "expected_result": { "type": ["string", "null"] },
    "observed_result": { "type": ["string", "null"] },
    "reproducer_path": { "type": ["string", "null"] },
    "linux_comparison": { "type": ["string", "null"] },
    "scml_support_status": { "type": ["string", "null"] },
    "security_impact": { "type": ["string", "null"] },
    "confidence": { "enum": ["low", "medium", "high"] },
    "raw_artifact_paths": { "type": "array", "items": { "type": "string" } }
  }
}
